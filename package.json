{
  "name": "smart-second-brain",
  "version": "2.1.2",
  "main": "main.js",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22",
    "@types/stopword": "^2.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.5",
    "events": "^3.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.4.0",
    "obsidian": "^1.13.1",
    "postcss": "^8.5.28",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development vite build --mode development --watch",
    "build": "vite build --mode production",
    "check": "svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.test.json",
    "check:src": "svelte-check --tsconfig ./tsconfig.json",
    "check:test": "svelte-check --tsconfig ./tsconfig.test.json",
    "format": "biome format --write ./src ./test ./integration",
    "lint": "biome lint --write ./src ./test ./integration",
    "lint:unsafe": "biome lint --write --unsafe ./src ./test ./integration",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "setup-slots": "bash scripts/setup-agent-slots.sh",
    "setup-vault": "mkdir -p 'integration/S2B Test Vault/.obsidian/plugins/smart-second-brain' && cd 'integration/S2B Test Vault/.obsidian/plugins/smart-second-brain' && ln -sf ../../../../../build/smart-second-brain/main.js main.js && ln -sf ../../../../../build/smart-second-brain/styles.css styles.css && ln -sf ../../../../../build/smart-second-brain/manifest.json manifest.json",
    "corpus:generate": "bun run scripts/generate-search-corpus.ts",
    "bench:layout": "bun run scripts/graph-layout-bench.ts",
    "bench:vector-memory": "bun run scripts/vector-memory-bench.ts",
    "test:benchmark": "vitest run --config vitest.integration.config.ts integration/search-relevance-benchmark.test.ts"
  },
  "type": "module",
  "dependencies": {
    "@langchain/anthropic": "^1.5.9",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-sdk": "^1.10.2",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.11",
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/svelte-query": "^6.1.48",
    "bits-ui": "^2.19.0",
    "d3-force": "^3.0.0",
    "deepagents": "^1.13.3",
    "diff": "^8.0.4",
    "hnsw": "^1.1.1",
    "langchain": "^1.5.10",
    "langsmith": "^0.8.12",
    "leiden-ts": "^0.1.0",
    "minisearch": "^7.2.0",
    "pdf-lib": "^1.17.1",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.20.1",
    "runed": "^0.37.1",
    "stopword": "^3.1.5",
    "svelte-i18n": "^4.0.1",
    "uuid": "^11.1.1",
    "zod": "^4.5.4"
  },
  "overrides": {
    "hono": "^4.13.7",
    "@hono/node-server": "^1.19.10",
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0",
    "path-to-regexp": "^8.4.0",
    "body-parser": "^2.3.0",
    "ajv": "^8.18.0",
    "ip-address": "^10.7.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^6.1.3",
    "rollup": "^4.63.1",
    "ws": "^8.21.3",
    "esbuild": "^0.28.2"
  }
}
