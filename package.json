{
  "name": "smart-second-brain",
  "version": "2.7.2",
  "main": "main.js",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.7",
    "@types/stopword": "^2.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.7.0",
    "events": "^3.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^27.4.0",
    "obsidian": "^1.14.4",
    "plotly.js-gl3d-dist-min": "^4.3.0",
    "postcss": "^8.5.33",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development vite build --mode development --watch",
    "build": "vite build --mode production",
    "check": "svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.test.json",
    "check:src": "svelte-check --tsconfig ./tsconfig.json",
    "check:test": "svelte-check --tsconfig ./tsconfig.test.json",
    "format": "biome format --write ./src ./test ./integration",
    "lint": "biome lint --write ./src ./test ./integration",
    "lint:unsafe": "biome lint --write --unsafe ./src ./test ./integration",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "setup-slots": "bash scripts/setup-agent-slots.sh",
    "setup-vault": "mkdir -p 'integration/S2B Test Vault/.obsidian/plugins/smart-second-brain' && cd 'integration/S2B Test Vault/.obsidian/plugins/smart-second-brain' && ln -sf ../../../../../build/smart-second-brain/main.js main.js && ln -sf ../../../../../build/smart-second-brain/styles.css styles.css && ln -sf ../../../../../build/smart-second-brain/manifest.json manifest.json",
    "corpus:generate": "bun run scripts/generate-search-corpus.ts",
    "bench:layout": "bun run scripts/graph-layout-bench.ts",
    "bench:vector-memory": "bun run scripts/vector-memory-bench.ts",
    "directory:refresh": "bun run scripts/refresh-provider-directory.ts",
    "test:benchmark": "vitest run --config vitest.integration.config.ts integration/search-relevance-benchmark.test.ts"
  },
  "type": "module",
  "dependencies": {
    "@langchain/anthropic": "^1.6.6",
    "@langchain/core": "^1.5.1",
    "@langchain/google-genai": "2.3.6",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint": "^1.2.3",
    "@langchain/langgraph-sdk": "~1.17.0",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/ollama": "^1.3.1",
    "@langchain/openai": "^1.8.5",
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/svelte-query": "^6.4.7",
    "bits-ui": "^2.22.0",
    "d3-force": "^3.0.1",
    "deepagents": "^1.17.1",
    "diff": "^8.0.4",
    "hnsw": "^1.1.1",
    "langchain": "^1.6.8",
    "langsmith": "^0.12.0",
    "leiden-ts": "^0.1.0",
    "minisearch": "^7.2.0",
    "pdf-lib": "^1.17.1",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.23.0",
    "runed": "^0.37.1",
    "stopword": "^3.1.5",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "hono": "^4.13.11",
    "@hono/node-server": "^2.1.3",
    "fast-uri": "^3.1.8",
    "qs": "^6.17.1",
    "path-to-regexp": "^8.4.0",
    "body-parser": "^2.4.0",
    "ajv": "^8.18.0",
    "ip-address": "^10.7.6",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^6.1.5",
    "rollup": "^4.63.1",
    "ws": "^8.21.3",
    "esbuild": "^0.28.2",
    "proxy-addr": "^2.0.8",
    "zod": "^4.6.6",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "source-map-js": "^1.2.2"
  }
}
